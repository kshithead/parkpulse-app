# ParkPulse configuration (all optional)
#
# Server (node server/server.js)
# PORT=5000                 # API / production web port
# SEED_MODE=demo            # demo | clean  (only used when no database exists yet)
# DB_FILE=./server/data/db.json
# UPLOADS_DIR=./server/data/uploads
# CORS_ORIGIN=              # comma-separated origins, only needed if the UI is hosted elsewhere
#
# Client (vite)
# VITE_API_BASE_URL=        # leave empty: same origin (dev proxy / production). Set only for a separately hosted API.
# VITE_PROXY_TARGET=http://localhost:5000
